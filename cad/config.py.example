"""
Darwin-Neo Master Configuration
Parametric Logic for High-Mass, Low-Cost 3D Printing.
"""

# --- 1. DONOR & FRAME PATH ---
# Donor type - what kind of printers are you scavenging?
# Options: "PRUSA_CLONE", "ENDER_3", "SCAVENGED"
DONOR_TYPE = "ENDER_3"

# Frame path - determines frame construction and motion system
# Options: "Scaffold" (M10 rods), "Mill" (V-slots), "Lathe" (extrusion + smooth rods)
# See ADR-025 for details on each path
FRAME_PATH = "Scaffold"  # M10 threaded-rod skeleton + printed corners (ADR-001, ADR-025)
# Options: "Scaffold" (M10 rod skeleton), "Mill" (V-slot extrusion), "Lathe" (extrusion + rods)

# --- 2. THE SKELETON (M10 RODS) ---
# M10 chosen over M12: 3x rigidity of M8, standard 17mm wrench, easier to cut
# See ADR-001 for full rationale
M10_NOMINAL_DIA = 10.0
# Set 0.2 for Zinc, 0.5+ for Galvanized (The "Lumpy Factor")
LUMPY_FACTOR = 0.5
M10_FIT_DIA = M10_NOMINAL_DIA + LUMPY_FACTOR

# Legacy alias for compatibility
M12_NOMINAL_DIA = M10_NOMINAL_DIA  # DEPRECATED: Use M10_NOMINAL_DIA
M12_FIT_DIA = M10_FIT_DIA  # DEPRECATED: Use M10_FIT_DIA

# --- 3. MOTION FORK (SMOOTH RODS) ---
# Reference spec: Dual 8mm with vertical stacking (see ADR-021)
# Alternative: 10.0 for single-rod "Neo" builds (purchased rods)
SMOOTH_ROD_DIA = 8.0
SMOOTH_ROD_CONFIG = "DUAL_VERTICAL"  # "DUAL_VERTICAL" (reference) or "SINGLE"
BEARING_TYPE = "LM8UU"  # LM8LUU recommended for X-axis (see ADR-022)

# --- 4. TIER DEFINITIONS ---
TRIPLE_Z = True  # True = Independent 3-point Z-Tilt
EXTRUDER_TYPE = "PITAN"  # 3:1 geared, single-drive (see ADR-019)
# Options: "PITAN" (reference), "WADE" (heritage), "MK8" (ultra-scavenger)
HOTEND_DONOR = "ENDER_MK8"

# --- 5. BUILD VOLUME ---
# Reference spec: 220×220×220mm (Anet A8 scavenger bed size)
# See ADR-024 for bed size selection rationale
# Alternatives: 200×200 (Prusa clone), 235×235 (Ender 3), 250×210 (Prusa MK3)
BUILD_VOLUME = {"X": 220, "Y": 220, "Z": 220}

# --- 6. DYNAMIC FRAME CALCULATIONS ---
# Extruder overhang on X-axis (Wade needs more than Pitan)
X_OVERHANG = 50.0 if EXTRUDER_TYPE == "WADE" else 35.0 if EXTRUDER_TYPE == "PITAN" else 25.0

# --- 6.1 FRAME GEOMETRY (Amalgam M10 Frame) ---
# The frame is a box of 12 M10 rods: 4 corner uprights and 4 rods along each
# of the bottom and top edges, joined by 8 printed corner brackets.

# FRAME SIZE. amalgam/lib/layout.py derives these from what has to fit: the
# gantry's travel, the bed's travel and the stack of parts under the bed.
# The values below suit the 220 x 220 x 220 reference build volume. If you
# change BUILD_VOLUME, regenerate them with:
#   cd cad && python -c "from amalgam.lib import layout as L; \
#   print(L.builder_skeleton(L.LayoutConfig(bed_x=220, bed_y=220, build_z=220)))"
#
#   skeleton_x  distance between the left and right uprights
#   skeleton_y  distance between the front and back uprights
#   skeleton_z  distance between the bottom and top X rods
#
# cad/tests/test_layout.py checks these against the layout.
SKELETON_X = 325  # left to right, between the uprights (mm)
SKELETON_Y = 355  # front to back, between the uprights (mm)
SKELETON_Z = 250  # bottom to top, between the X rods (mm)

# Corner Design Parameters
CORNER_SIZE = 50.0              # Size of corner cube (mm)
WALL_THICKNESS = 5.0            # Wall thickness of corner parts (mm)
JAM_NUT_ACCESS_DIA = 20.0       # Diameter for jam nut access holes (mm)

# Vertical Rod Positions. One upright at each corner, and no centre rods.
FRONT_LEFT_V = True  # VFL
FRONT_CENTER_V = False  # VFC (optional center rod)
FRONT_RIGHT_V = True  # VFR
BACK_LEFT_V = True  # VBL
BACK_CENTER_V = False  # VBC
BACK_RIGHT_V = True  # VBR

# Z-System Mounting. The three Z motors sit on pucks on the plinth
# (ADR-010), so no corner bracket carries a motor.
TRIPLE_Z = True
Z_MOUNT_PATTERN = (
    "FRONT_CORNERS_BACK_BOTTOM"  # Two at the front corners, one at the back centre
)

# Corner Count and Types. All four bottom brackets are the same part.
BOTTOM_CORNERS = 4  # all standard
TOP_CORNERS = 4  # carry the XY gantry
TOTAL_CORNERS = 8

# Z-Motor Locations
Z1_LOCATION = "front_left"  # Puck on the plinth
Z2_LOCATION = "front_right"  # Puck on the plinth
Z3_LOCATION = "back_centre"  # Puck on the plinth

# Corner Types
FRONT_LEFT_CORNER = "STANDARD"
FRONT_RIGHT_CORNER = "STANDARD"
BACK_LEFT_CORNER = "STANDARD"
BACK_RIGHT_CORNER = "STANDARD"

# Z travel this frame allows, from amalgam/lib/layout.py. It must be at least
# BUILD_VOLUME["Z"]. cad/tests/test_layout.py checks it.
Z_TRAVEL_MAX = 224.75

# --- 6.2 SPIDER BED SUPPORT ---
SPIDER_ARM_LENGTH = 150
SPIDER_HUB_SIZE = 120
SPIDER_BOLT_PATTERN = "M6"
SPIDER_INTERLOCK = True
SPIDER_LEADSCREW_SPACING = 40  # Distance between leadscrews for hub


# --- 7. EXPORT SETTINGS ---
# Default export format for build.sh
# Options: "stl" (default), "step", "3mf", "brep", "gltf", "all"
# STL: Standard 3D printing format
# STEP: CAD interchange (Fusion 360, FreeCAD, SolidWorks)
# 3MF: Modern slicer format with metadata
# BREP: build123d native (exact geometry)
# glTF: Web/visualization (3D viewers)
# all: Export all formats
EXPORT_FORMAT = "stl"

# Generate technical drawings (orthographic projections)
# Creates front, top, side, and isometric views as SVG and PDF
EXPORT_DRAWINGS = False


# --- 8. BRAND & COSMETICS ---
# The Amalgam visual identity: Dark Grey body, White logo accent, Black base.
# Creates a layered look: black base → grey parts with white logos → silver hardware.

# Official palette (hex). Feeds into 3MF/glTF exports, docs, and website.
BRAND_BODY_COLOR = "#4A4A4A"       # Dark Grey — printed parts
BRAND_ACCENT_COLOR = "#FFFFFF"     # White — logo pad / raised details
BRAND_BASE_COLOR = "#1A1A1A"       # Near-Black — MDF base (painted), aluminum extrusions

# Logo pad on printed parts.
# A raised 0.5mm pad with the Amalgam octagon+A mark.
# Print in body color, then filament-swap to white at the pad layer for accent.
# No MMU required — single pause/swap at the right layer height.
LOGO_PAD_ENABLED = True            # Set False for plain parts (no branding)
LOGO_PAD_DIAMETER = 18.0           # mm, across flats
LOGO_PAD_HEIGHT = 0.5              # mm raised above surface (2-3 layers at 0.2mm)

# Texture recommendation (applied in slicer, not in geometry).
# Fuzzy skin on cosmetic surfaces gives an industrial "cast iron" texture,
# hides layer lines, and adds grip. Leave functional mating surfaces smooth.
FUZZY_SKIN_RECOMMENDED = True
FUZZY_SKIN_POINT_DISTANCE = 0.3   # mm between fuzzy points
FUZZY_SKIN_THICKNESS = 0.2        # mm fuzzy skin depth


# --- 9. UTILITIES ---
def print_config_summary():
    """Manifesto Transparency Check"""
    print(f"--- Darwin-Neo Configuration: {DONOR_TYPE} Path ---")
    if DONOR_TYPE == "ENDER_3":
        print(
            f"!!! MOTION GAP: Ender rollers incompatible. Buy 6x {SMOOTH_ROD_DIA}mm rods."
        )
    print(f"Frame Dimensions: {SKELETON_X} x {SKELETON_Y} x {SKELETON_Z}")
    print(f"Z-Travel: {Z_TRAVEL_MAX}mm (Frame: {SKELETON_Z}mm)")
    print(f"Z-Motors: {Z1_LOCATION}, {Z2_LOCATION}, {Z3_LOCATION}")
    print(
        f"Parts: {BOTTOM_CORNERS} bottom corners + {TOP_CORNERS} top corners = {TOTAL_CORNERS} total"
    )
